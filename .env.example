# ---------------------------------------------
# App & Auth URLs
# Set per-environment; prod values go in hosting dashboard, not in a file.
# In local development, use .env.local:
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
#   AUTH_URL=http://localhost:3000
#   NEXTAUTH_URL=http://localhost:3000
# In production (Vercel), configure these in project environment variables.
# ---------------------------------------------
NEXT_PUBLIC_APP_URL=
AUTH_URL=
NEXTAUTH_URL=

# ---------------------------------------------
# Next-Auth / Auth.js (next-auth v5)
# ---------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=

# ---------------------------------------------
# Database (Neon Serverless Postgres)
# ---------------------------------------------
NEON_DATABASE_URL=

# ---------------------------------------------
# Google OAuth (optional - enables Google sign-in)
# ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------
# Razorpay (payment gateway)
# ---------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------
# Resend (transactional email)
# ---------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="InternAcademy <noreply@internacademy.co.in>"

# ---------------------------------------------
# OpenRouter (AI chatbot - InternBot)
# ---------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------
# Admin Seed Account (used by seed scripts only)
# ---------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------
# Cron Job Security (optional)
# ---------------------------------------------
CRON_SECRET=
